<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons"
                    oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    
    <!-- OfficeToolBar integration: Adds a SINGLE "Translate" button to the Addons toolbar -->
    <node oor:name="OfficeToolBar">
      <node oor:name="org.libreoffice.quicktranslator.toolbar" oor:op="replace">
        <node oor:name="m1" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>service:org.libreoffice.quicktranslator.TranslatorService?open</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value>Translate</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
          <prop oor:name="Context" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument</value>
          </prop>
        </node>
      </node>
    </node>

    <!-- Images / Icons for Toolbar Button -->
    <node oor:name="Images">
      <node oor:name="org.libreoffice.quicktranslator.images" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>service:org.libreoffice.quicktranslator.TranslatorService?open</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL">
            <value>%origin%/icons/icon_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL">
            <value>%origin%/icons/icon_26.png</value>
          </prop>
        </node>
      </node>
    </node>

  </node>
</oor:component-data>