<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar"
                    oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">

    <node oor:name="DeckList">
      <node oor:name="QuickTranslatorDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Quick Translator</value>
          <value xml:lang="it">Quick Translator</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>QuickTranslatorDeck</value>
        </prop>
        <prop oor:name="IconURL" oor:type="xs:string">
          <value>vnd.sun.star.extension://org.libreoffice.extensions.quicktranslator/icons/icon_26.png</value>
        </prop>
        <prop oor:name="TitleBarIconURL" oor:type="xs:string">
          <value>vnd.sun.star.extension://org.libreoffice.extensions.quicktranslator/icons/icon_16.png</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>600</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>
            <it>any, any, visible</it>
          </value>
        </prop>
      </node>
    </node>

    <node oor:name="PanelList">
      <node oor:name="QuickTranslatorPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Quick Translator</value>
          <value xml:lang="it">Quick Translator</value>
        </prop>
        <prop oor:name="TitleBarIsOptional" oor:type="xs:boolean">
          <value>true</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>QuickTranslatorPanel</value>
        </prop>
        <prop oor:name="DeckId" oor:type="xs:string">
          <value>QuickTranslatorDeck</value>
        </prop>
        <prop oor:name="TitleBarIconURL" oor:type="xs:string">
          <value>vnd.sun.star.extension://org.libreoffice.extensions.quicktranslator/icons/icon_16.png</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/QuickTranslator/Panel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>100</value>
        </prop>
        <prop oor:name="ShowForReadOnlyDocument" oor:type="xs:boolean">
          <value>true</value>
        </prop>
        <prop oor:name="WantsAWT" oor:type="xs:boolean">
          <value>true</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>
            <it>any, any, visible</it>
          </value>
        </prop>
      </node>
    </node>

  </node>
</oor:component-data>
